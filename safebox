#!/usr/bin/env bash
set -Eeuo pipefail
export LC_ALL=C

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$ROOT/config/defaults.conf"

SUDO=()
if [[ ${EUID} -ne 0 ]]; then SUDO=(sudo); fi

usage() {
  cat <<USAGE
KVM-QEMU-SafeBox ${SAFEBOX_VERSION}

Verwendung:
  bash ./install/install-host.sh
  bash ./safebox create-base /pfad/debian-13.x.x-amd64-netinst.iso
  # Gast installieren + guest/harden.sh ausführen + vollständig herunterfahren
  bash ./safebox seal-base
  # Optional: Runtime-Netz vorab prüfen/aktivieren
  bash ./safebox setup-network
  bash ./safebox start disposable
  bash ./safebox start persistent
  bash ./safebox start offline
  bash ./safebox viewer [DOMAIN]
  bash ./safebox verify-runtime [DOMAIN]
  bash ./safebox status
  bash ./safebox doctor
  bash ./safebox cleanup-sessions

Modi:
  disposable  Temporäres QCOW2-Overlay; wird nach VM-Ende gelöscht.
  persistent  Dauerhaftes Overlay; Basis-Image bleibt unverändert.
  offline     Wie disposable, aber ohne virtuelle Netzwerkkarte.

Sicherheitsprinzip:
  SafeBox startet fail-closed. Host-Härtung, Netzpolicy und die tatsächlich
  laufende QEMU-Instanz werden verifiziert. Eine fehlgeschlagene Runtime-
  Attestation beendet die VM automatisch.
USAGE
}

die(){ echo "FEHLER: $*" >&2; exit 1; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Benötigtes Programm fehlt: $1"; }

qemu_user() {
  local u
  for u in libvirt-qemu qemu; do
    if id -u "$u" >/dev/null 2>&1; then printf '%s\n' "$u"; return 0; fi
  done
  die "Kein dedizierter QEMU-Dienstbenutzer gefunden. Root-Fallback ist aus Sicherheitsgründen verboten."
}

qemu_group() {
  local u
  u="$(qemu_user)"
  id -gn "$u" 2>/dev/null || die "Primäre Gruppe des QEMU-Dienstbenutzers konnte nicht ermittelt werden: $u"
}

prepare_storage() {
  local group
  group="$(qemu_group)"
  "${SUDO[@]}" install -d -m 0750 -o root -g "$group" "$SAFEBOX_STORAGE" "$SAFEBOX_SESSIONS_DIR"
}

set_qemu_owner() {
  local file=$1 mode=${2:-0600} user group
  user="$(qemu_user)"; group="$(qemu_group)"
  "${SUDO[@]}" chown "$user:$group" "$file"
  "${SUDO[@]}" chmod "$mode" "$file"
}

set_root_readonly() {
  local file=$1 group
  group="$(qemu_group)"
  "${SUDO[@]}" chown "root:$group" "$file"
  "${SUDO[@]}" chmod 0440 "$file"
}

xml_escape_check() {
  local value=$1 forbidden
  for forbidden in '&' '<' '>' $'\x27' '|' $'\\' $'\n' $'\r'; do
    [[ "$value" != *"$forbidden"* ]] || die "Nicht unterstütztes Sonderzeichen im Pfad: $value"
  done
}

render_template() {
  local template=$1 output=$2 domain=$3 disk=$4 network_block=$5 iso=${6:-}
  xml_escape_check "$disk"
  [[ -z "$iso" ]] || xml_escape_check "$iso"
  sed \
    -e "s|__DOMAIN_NAME__|$domain|g" \
    -e "s|__RAM_MIB__|$SAFEBOX_RAM_MIB|g" \
    -e "s|__VCPUS__|$SAFEBOX_VCPUS|g" \
    -e "s|__DISK_IMAGE__|$disk|g" \
    -e "s|__ISO_IMAGE__|$iso|g" \
    "$template" > "$output.tmp"
  awk -v block="$network_block" '/__NETWORK_BLOCK__/ { print block; next } { print }' "$output.tmp" > "$output"
  rm -f "$output.tmp"
}

running_safebox_domains() {
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" list --name 2>/dev/null | grep -E '^safebox-(installer|persistent|disposable-|offline-)' || true
}

assert_no_running_safebox() {
  local running
  running="$(running_safebox_domains)"
  [[ -z "$running" ]] || die "Es läuft bereits eine SafeBox-Domain: $running. Absichtlich nur eine Sitzung gleichzeitig."
}

assert_host_hardening() {
  need virsh; need aa-status
  aa-status --enabled >/dev/null 2>&1 || die "AppArmor ist nicht aktiviert. Zuerst bash ./install/install-host.sh ausführen."
  [[ -f "$SAFEBOX_QEMU_CONF" ]] || die "$SAFEBOX_QEMU_CONF fehlt."
  local conf caps
  conf="$("${SUDO[@]}" cat "$SAFEBOX_QEMU_CONF")"
  grep -Eq '^security_driver[[:space:]]*=[[:space:]]*"apparmor"[[:space:]]*$' <<<"$conf" || die "libvirt erzwingt AppArmor nicht. Zuerst install-host ausführen."
  grep -Eq '^security_default_confined[[:space:]]*=[[:space:]]*1[[:space:]]*$' <<<"$conf" || die "security_default_confined=1 fehlt."
  grep -Eq '^security_require_confined[[:space:]]*=[[:space:]]*1[[:space:]]*$' <<<"$conf" || die "security_require_confined=1 fehlt."
  grep -Eq '^seccomp_sandbox[[:space:]]*=[[:space:]]*1[[:space:]]*$' <<<"$conf" || die "seccomp_sandbox=1 fehlt."
  grep -Eq '^max_core[[:space:]]*=[[:space:]]*0[[:space:]]*$' <<<"$conf" || die "max_core=0 fehlt."
  grep -Eq '^dump_guest_core[[:space:]]*=[[:space:]]*0[[:space:]]*$' <<<"$conf" || die "dump_guest_core=0 fehlt."
  caps="$("${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" capabilities 2>/dev/null)"
  grep -q '<model>apparmor</model>' <<<"$caps" || die "libvirt meldet AppArmor nicht als Security Model."
  qemu_user >/dev/null
}

verify_clean_traffic_filter() {
  local xml f
  xml="$("${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" nwfilter-dumpxml clean-traffic 2>/dev/null)" || \
    die "libvirt-Standardfilter clean-traffic fehlt. Installiere libvirt-daemon-config-nwfilter."
  for f in no-mac-spoofing no-ip-spoofing no-arp-spoofing no-other-l2-traffic; do
    grep -q "filter='$f'" <<<"$xml" || die "clean-traffic enthält nicht den erwarteten Baustein: $f"
  done
}

ensure_nwfilter() {
  # SafeBox verwendet absichtlich direkt libvirts Standardfilter. Dadurch
  # werden die offiziell unterstützten Interface-Parameter IP bzw.
  # CTRL_IP_LEARNING ohne eigene Wrapper-/Vererbungslogik angewendet.
  verify_clean_traffic_filter
}

verify_network_live() {
  local mode=${1:-runtime} name bridge tmp
  need xmllint
  case "$mode" in
    runtime) name="$SAFEBOX_NETWORK"; bridge="$SAFEBOX_BRIDGE" ;;
    installer) name="$SAFEBOX_INSTALL_NETWORK_NAME"; bridge="$SAFEBOX_INSTALL_BRIDGE" ;;
    *) return 1 ;;
  esac

  tmp="$(mktemp)"
  if ! "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-dumpxml "$name" > "$tmp" 2>/dev/null; then
    rm -f "$tmp"; return 1
  fi
  x(){ xmllint --xpath "$1" "$tmp" 2>/dev/null; }
  [[ "$(x 'string(/network/name)')" == "$name" ]] || { rm -f "$tmp"; return 1; }
  [[ "$(x 'string(/network/forward/@mode)')" == "nat" ]] || { rm -f "$tmp"; return 1; }
  [[ "$(x 'string(/network/bridge/@name)')" == "$bridge" ]] || { rm -f "$tmp"; return 1; }
  [[ "$(x 'string(/network/port/@isolated)')" == "yes" ]] || { rm -f "$tmp"; return 1; }
  [[ "$(x 'count(/network/ip)')" == "1" ]] || { rm -f "$tmp"; return 1; }
  [[ "$(x 'string(/network/ip/@address)')" == "$SAFEBOX_GATEWAY" ]] || { rm -f "$tmp"; return 1; }
  [[ "$(x 'string(/network/ip/@netmask)')" == "255.255.255.0" ]] || { rm -f "$tmp"; return 1; }
  [[ "$(x 'count(/network/ip[@family="ipv6"])')" == "0" ]] || { rm -f "$tmp"; return 1; }

  if [[ "$mode" == "runtime" ]]; then
    # Laufzeit: kein dnsmasq-Angriffspunkt. Weder DHCP noch DNS werden durch
    # libvirt auf dieser Bridge bereitgestellt.
    [[ "$(x 'count(/network/dns[@enable="no"])')" == "1" ]] || { rm -f "$tmp"; return 1; }
    [[ "$(x 'count(/network/ip/dhcp)')" == "0" ]] || { rm -f "$tmp"; return 1; }
    [[ "$(x 'count(/network/domain)')" == "0" ]] || { rm -f "$tmp"; return 1; }
  else
    [[ "$(x 'count(/network/dns[@enable="yes"])')" == "1" ]] || { rm -f "$tmp"; return 1; }
    [[ "$(x 'count(/network/ip/dhcp/range)')" == "0" ]] || { rm -f "$tmp"; return 1; }
    [[ "$(x 'count(/network/ip/dhcp/host)')" == "1" ]] || { rm -f "$tmp"; return 1; }
    [[ "$(x 'string(/network/ip/dhcp/host/@mac)')" == "$SAFEBOX_MAC" ]] || { rm -f "$tmp"; return 1; }
    [[ "$(x 'string(/network/ip/dhcp/host/@ip)')" == "$SAFEBOX_GUEST_IP" ]] || { rm -f "$tmp"; return 1; }
  fi
  rm -f "$tmp"
  return 0
}

network_active() {
  local name=$1
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-info "$name" 2>/dev/null | grep -qE '^Active:[[:space:]]+yes$'
}

runtime_dnsmasq_absent() {
  # libvirt sollte bei <dns enable='no'/> und ohne <dhcp> keinen dnsmasq für
  # das Runtime-Netz starten. Ein unerwarteter Prozess ist ein harter Fehler.
  if command -v pgrep >/dev/null 2>&1 && pgrep -af '[d]nsmasq' 2>/dev/null | grep -Fq "/$SAFEBOX_NETWORK.conf"; then
    return 1
  fi
  return 0
}

verify_firewall_live() {
  local live rule
  live="$("${SUDO[@]}" nft list table inet safebox_guard 2>/dev/null)" || return 1
  for rule in \
    'iifname "virbr-safebox" meta nfproto ipv6 drop' \
    'oifname "virbr-safebox" meta nfproto ipv6 drop' \
    'iifname "virbr-safebox" drop' \
    'oifname "virbr-safebox" drop' \
    'iifname "virbr-safebox" ip saddr != 10.77.0.100 drop' \
    'iifname "virbr-safebox-inst" meta nfproto ipv6 drop' \
    'oifname "virbr-safebox-inst" meta nfproto ipv6 drop' \
    'iifname "virbr-safebox-inst" drop' \
    'oifname "virbr-safebox-inst" drop' \
    'iifname "virbr-safebox-inst" ip saddr != 10.77.0.100 drop'; do
    grep -Fq "$rule" <<<"$live" || return 1
  done
  grep -Fq '192.168.0.0/16' <<<"$live" || return 1
  grep -Fq '10.0.0.0/8' <<<"$live" || return 1
  grep -Fq '172.16.0.0/12' <<<"$live" || return 1
}

ensure_guard_and_filter() {
  assert_host_hardening
  "${SUDO[@]}" bash "$ROOT/network/install-firewall-service.sh"
  verify_firewall_live || die "Host-Firewall konnte nach dem Laden nicht verifiziert werden."
  ensure_nwfilter
}

ensure_network_definition() {
  local mode=$1 name xml
  case "$mode" in
    runtime) name="$SAFEBOX_NETWORK"; xml="$ROOT/network/safebox-net.xml" ;;
    installer) name="$SAFEBOX_INSTALL_NETWORK_NAME"; xml="$ROOT/network/safebox-install-net.xml" ;;
    *) die "Interner Fehler: unbekannter Netzwerkmodus $mode" ;;
  esac

  if "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-info "$name" >/dev/null 2>&1; then
    verify_network_live "$mode" || die "Vorhandenes '$name' weicht von der erwarteten SafeBox-Policy ab. Start verweigert."
  else
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-define "$xml" >/dev/null
    verify_network_live "$mode" || die "Neu definiertes Netzwerk '$name' konnte nicht verifiziert werden."
  fi

  if ! network_active "$name"; then
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-start "$name" >/dev/null
  fi
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-autostart "$name" --disable >/dev/null
  verify_network_live "$mode" || die "Live-Netzwerkprüfung nach net-start fehlgeschlagen: $name"
  verify_firewall_live || die "Firewall ist nach net-start nicht mehr vollständig aktiv."
}

setup_network() {
  need virsh; need nft; need xmllint; need pgrep
  ensure_guard_and_filter
  if network_active "$SAFEBOX_INSTALL_NETWORK_NAME"; then
    die "Installationsnetz '$SAFEBOX_INSTALL_NETWORK_NAME' ist noch aktiv. Erst Installer herunterfahren und 'seal-base' ausführen."
  fi
  ensure_network_definition runtime
  runtime_dnsmasq_absent || die "Unerwarteter dnsmasq-Prozess für das Runtime-Netz. Start verweigert."
  echo "[OK] Runtime-Netz ohne Host-DHCP/DNS, Anti-Spoofing-nwfilter und Host/LAN/IPv6-Guard verifiziert."
}

setup_install_network() {
  need virsh; need nft; need xmllint; need pgrep
  ensure_guard_and_filter
  if network_active "$SAFEBOX_NETWORK"; then
    verify_network_live runtime || die "Aktives Runtime-Netz weicht von der SafeBox-Policy ab; automatische Umschaltung verweigert."
    runtime_dnsmasq_absent || die "Unerwarteter dnsmasq-Prozess am Runtime-Netz; automatische Umschaltung verweigert."
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-destroy "$SAFEBOX_NETWORK" >/dev/null
    echo "[OK] Inaktives Installationsfenster hergestellt: Runtime-Netz gestoppt."
  fi
  ensure_network_definition installer
  echo "[OK] Separates Installationsnetz mit eng begrenztem DHCP/DNS-Zugriff verifiziert."
}

remove_install_network() {
  if ! "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-info "$SAFEBOX_INSTALL_NETWORK_NAME" >/dev/null 2>&1; then
    return 0
  fi
  verify_network_live installer || die "Installationsnetz weicht von der erwarteten Policy ab; automatische Entfernung verweigert."
  if network_active "$SAFEBOX_INSTALL_NETWORK_NAME"; then
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-destroy "$SAFEBOX_INSTALL_NETWORK_NAME" >/dev/null
  fi
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-undefine "$SAFEBOX_INSTALL_NETWORK_NAME" >/dev/null
  echo "[OK] Installationsnetz vollständig entfernt."
}

verify_base_integrity() {
  need qemu-img; need sha256sum
  [[ -f "$SAFEBOX_BASE_IMAGE" ]] || die "Basis-Image fehlt."
  [[ "$("${SUDO[@]}" stat -c '%a' "$SAFEBOX_BASE_IMAGE")" == "440" ]] || die "Basis-Image ist nicht Mode 0440."
  [[ "$("${SUDO[@]}" stat -c '%U' "$SAFEBOX_BASE_IMAGE")" == "root" ]] || die "Basis-Image gehört nicht root."
  [[ "$("${SUDO[@]}" qemu-img info --output=json "$SAFEBOX_BASE_IMAGE" | jq -r '.format')" == "qcow2" ]] || die "Basis-Image ist nicht QCOW2."
  if [[ "$SAFEBOX_VERIFY_BASE_HASH" == "1" ]]; then
    [[ -f "$SAFEBOX_BASE_HASH" ]] || die "SHA-256-Siegel fehlt: $SAFEBOX_BASE_HASH. Erneut seal-base ausführen."
    "${SUDO[@]}" sha256sum -c "$SAFEBOX_BASE_HASH" >/dev/null || die "SHA-256-Prüfung des Basis-Images FEHLGESCHLAGEN. Start verweigert."
  fi
}

verify_overlay() {
  local disk=$1 backing format
  format="$("${SUDO[@]}" qemu-img info --output=json "$disk" | jq -r '.format')"
  [[ "$format" == "qcow2" ]] || die "Overlay ist nicht QCOW2: $disk"
  backing="$("${SUDO[@]}" qemu-img info --output=json "$disk" | jq -r '."full-backing-filename" // ."backing-filename" // empty')"
  [[ "$backing" == "$SAFEBOX_BASE_IMAGE" ]] || die "Overlay verweist auf unerwartetes Backing-Image: ${backing:-keins}"
}

network_block() {
  cat <<XML
    <interface type='network'>
      <mac address='$SAFEBOX_MAC'/>
      <source network='$SAFEBOX_NETWORK'/>
      <model type='virtio'/>
      <rom bar='off'/>
      <port isolated='yes'/>
      <filterref filter='$SAFEBOX_NWFILTER'>
        <parameter name='IP' value='$SAFEBOX_GUEST_IP'/>
      </filterref>
    </interface>
XML
}

create_base() {
  local iso=${1:-} xml
  [[ -n "$iso" ]] || die "ISO-Pfad fehlt."
  iso="$(readlink -f -- "$iso")"
  [[ -f "$iso" ]] || die "ISO nicht gefunden: $iso"
  need qemu-img; need virsh; need jq
  assert_host_hardening
  assert_no_running_safebox
  setup_install_network
  prepare_storage

  "${SUDO[@]}" cp -- "$iso" "$SAFEBOX_INSTALL_ISO"
  set_root_readonly "$SAFEBOX_INSTALL_ISO"

  if [[ ! -f "$SAFEBOX_BASE_IMAGE" ]]; then
    "${SUDO[@]}" qemu-img create -f qcow2 "$SAFEBOX_BASE_IMAGE" "$SAFEBOX_DISK_SIZE" >/dev/null
  else
    [[ "$("${SUDO[@]}" stat -c '%a' "$SAFEBOX_BASE_IMAGE")" != "440" ]] || die "Basis-Image ist bereits versiegelt: $SAFEBOX_BASE_IMAGE"
    echo "[INFO] Unversiegeltes Basis-Image wird weiterverwendet."
  fi
  set_qemu_owner "$SAFEBOX_BASE_IMAGE" 0600
  "${SUDO[@]}" rm -f -- "$SAFEBOX_BASE_HASH"

  xml="$(mktemp --suffix=.xml)"
  render_template "$ROOT/vm/templates/installer.xml.in" "$xml" "safebox-installer" "$SAFEBOX_BASE_IMAGE" "" "$SAFEBOX_INSTALL_ISO"
  if command -v virt-xml-validate >/dev/null 2>&1; then virt-xml-validate "$xml" domain >/dev/null; fi

  if "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" dominfo safebox-installer >/dev/null 2>&1; then
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" undefine safebox-installer >/dev/null
  fi
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" define "$xml" >/dev/null
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" start safebox-installer >/dev/null
  rm -f "$xml"

  if ! bash "$ROOT/tools/runtime-verify.sh" safebox-installer installer "$SAFEBOX_BASE_IMAGE"; then
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" destroy safebox-installer >/dev/null 2>&1 || true
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" undefine safebox-installer >/dev/null 2>&1 || true
    die "Installer-Runtime-Attestation fehlgeschlagen; VM wurde beendet und entfernt."
  fi

  echo "[OK] Installer-VM läuft und Runtime-Attestation ist bestanden."
  echo "[INFO] Anzeige: bash ./safebox viewer safebox-installer"
}

seal_base() {
  need virsh; need qemu-img; need sha256sum
  [[ -f "$SAFEBOX_BASE_IMAGE" ]] || die "Basis-Image fehlt."
  if "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" dominfo safebox-installer >/dev/null 2>&1; then
    local state
    state="$("${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" domstate safebox-installer 2>/dev/null || true)"
    if grep -qiE 'running|laufend|paused|angehalten' <<<"$state"; then
      die "Installer-VM läuft noch. Debian vollständig herunterfahren."
    fi
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" undefine safebox-installer >/dev/null
  fi
  remove_install_network
  "${SUDO[@]}" qemu-img check "$SAFEBOX_BASE_IMAGE"
  set_root_readonly "$SAFEBOX_BASE_IMAGE"

  local tmp_hash group
  tmp_hash="$(mktemp)"
  "${SUDO[@]}" sha256sum "$SAFEBOX_BASE_IMAGE" > "$tmp_hash"
  group="$(qemu_group)"
  "${SUDO[@]}" install -m 0440 -o root -g "$group" "$tmp_hash" "$SAFEBOX_BASE_HASH"
  rm -f "$tmp_hash"
  "${SUDO[@]}" rm -f -- "$SAFEBOX_INSTALL_ISO"
  verify_base_integrity
  echo "[OK] Basis-Image geprüft, schreibgeschützt und mit SHA-256 versiegelt."
}

start_vm() {
  local mode=${1:-disposable} stamp domain disk netblock disposable=0 xml
  [[ "$mode" =~ ^(disposable|persistent|offline)$ ]] || die "Unbekannter Modus: $mode"
  need qemu-img; need virsh; need jq; need xmllint
  assert_host_hardening
  verify_base_integrity
  assert_no_running_safebox
  prepare_storage
  if [[ "$mode" != "offline" ]]; then setup_network; fi

  stamp="$(date +%Y%m%d-%H%M%S)-$$"
  netblock="$(network_block)"
  case "$mode" in
    persistent)
      domain="safebox-persistent"; disk="$SAFEBOX_PERSISTENT_IMAGE"
      if [[ ! -f "$disk" ]]; then
        "${SUDO[@]}" qemu-img create -f qcow2 -F qcow2 -b "$SAFEBOX_BASE_IMAGE" "$disk" >/dev/null
      fi
      set_qemu_owner "$disk" 0600
      ;;
    disposable)
      domain="safebox-disposable-$stamp"; disk="$SAFEBOX_SESSIONS_DIR/$domain.qcow2"; disposable=1
      "${SUDO[@]}" qemu-img create -f qcow2 -F qcow2 -b "$SAFEBOX_BASE_IMAGE" "$disk" >/dev/null
      set_qemu_owner "$disk" 0600
      ;;
    offline)
      domain="safebox-offline-$stamp"; disk="$SAFEBOX_SESSIONS_DIR/$domain.qcow2"; disposable=1; netblock=""
      "${SUDO[@]}" qemu-img create -f qcow2 -F qcow2 -b "$SAFEBOX_BASE_IMAGE" "$disk" >/dev/null
      set_qemu_owner "$disk" 0600
      ;;
  esac
  verify_overlay "$disk"

  xml="$(mktemp --suffix=.xml)"
  render_template "$ROOT/vm/templates/runtime.xml.in" "$xml" "$domain" "$disk" "$netblock"
  if command -v virt-xml-validate >/dev/null 2>&1; then virt-xml-validate "$xml" domain >/dev/null; fi

  if ! "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" create "$xml" >/dev/null; then
    rm -f "$xml"
    [[ "$disposable" -eq 0 ]] || "${SUDO[@]}" rm -f -- "$disk"
    die "VM-Start fehlgeschlagen."
  fi
  rm -f "$xml"

  local verify_mode=online
  [[ "$mode" == "offline" ]] && verify_mode=offline
  if ! bash "$ROOT/tools/runtime-verify.sh" "$domain" "$verify_mode" "$disk"; then
    "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" destroy "$domain" >/dev/null 2>&1 || true
    [[ "$disposable" -eq 0 ]] || "${SUDO[@]}" rm -f -- "$disk"
    die "Runtime-Attestation fehlgeschlagen. Die VM wurde fail-closed beendet."
  fi

  echo "[OK] $domain gestartet ($mode) – Runtime-Attestation bestanden."
  if command -v virt-viewer >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    virt-viewer --connect "$SAFEBOX_CONNECT_URI" --wait "$domain" || true
  else
    echo "[INFO] GUI öffnen mit: bash ./safebox viewer $domain"
  fi

  if [[ "$disposable" -eq 1 ]]; then
    echo "[INFO] Temporäres Overlay wird nach Ende der transienten Domain gelöscht."
    while "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" dominfo "$domain" >/dev/null 2>&1; do sleep 2; done
    "${SUDO[@]}" rm -f -- "$disk"
    echo "[OK] Temporäres Overlay gelöscht: $disk"
  fi
}

viewer() {
  local domain=${1:-safebox-persistent}
  need virt-viewer
  exec virt-viewer --connect "$SAFEBOX_CONNECT_URI" --wait "$domain"
}

verify_runtime_command() {
  local domain=${1:-}
  if [[ -z "$domain" ]]; then
    domain="$(running_safebox_domains | head -n1)"
  fi
  [[ -n "$domain" ]] || die "Keine laufende SafeBox-Domain gefunden."
  bash "$ROOT/tools/runtime-verify.sh" "$domain" auto
}

status() {
  echo "== Domains =="
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" list --all || true
  echo
  echo "== SafeBox-Runtime-Netz =="
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-info "$SAFEBOX_NETWORK" 2>/dev/null || echo "nicht definiert"
  echo
  echo "== SafeBox-Installationsnetz =="
  "${SUDO[@]}" virsh -c "$SAFEBOX_CONNECT_URI" net-info "$SAFEBOX_INSTALL_NETWORK_NAME" 2>/dev/null || echo "nicht definiert"
  echo
  echo "== Guard =="
  if verify_firewall_live; then echo "[OK] safebox_guard vollständig"; else echo "[FEHLER] safebox_guard fehlt/unvollständig"; fi
}

cleanup_sessions() {
  assert_no_running_safebox
  prepare_storage
  "${SUDO[@]}" find "$SAFEBOX_SESSIONS_DIR" -maxdepth 1 -type f -name 'safebox-*.qcow2' -print
  "${SUDO[@]}" find "$SAFEBOX_SESSIONS_DIR" -maxdepth 1 -type f -name 'safebox-*.qcow2' -delete
  echo "[OK] Verwaiste temporäre Sitzungs-Overlays entfernt."
}

case "${1:-}" in
  setup-network) setup_network ;;
  create-base) shift; create_base "$@" ;;
  seal-base) seal_base ;;
  start) shift; start_vm "${1:-disposable}" ;;
  viewer) shift; viewer "${1:-safebox-persistent}" ;;
  verify-runtime) shift; verify_runtime_command "${1:-}" ;;
  status) status ;;
  doctor) exec bash "$ROOT/tests/doctor.sh" ;;
  cleanup-sessions) cleanup_sessions ;;
  -h|--help|help|'') usage ;;
  *) usage; die "Unbekannter Befehl: $1" ;;
esac
