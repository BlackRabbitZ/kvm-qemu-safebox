<domain type='kvm'>
  <name>safebox-installer</name>
  <memory unit='MiB' dumpCore='off'>__RAM_MIB__</memory>
  <currentMemory unit='MiB'>__RAM_MIB__</currentMemory>
  <memoryBacking>
    <nosharepages/>
  </memoryBacking>
  <vcpu placement='static'>__VCPUS__</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='cdrom'/>
    <boot dev='hd'/>
    <bootmenu enable='yes' timeout='3000'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <pmu state='off'/>
    <vmport state='off'/>
  </features>

  <cpu mode='host-model' check='partial'>
    <!-- Keine Nested-Virtualisierung im Sandbox-Gast. -->
    <feature policy='disable' name='vmx'/>
    <feature policy='disable' name='svm'/>
  </cpu>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native' discard='unmap'/>
      <source file='__DISK_IMAGE__'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='__ISO_IMAGE__'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>

    <controller type='pci' index='0' model='pcie-root'/>
    <controller type='sata' index='0'/>
    <controller type='usb' model='none'/>

    <interface type='network'>
      <mac address='52:54:00:77:00:10'/>
      <source network='safebox-net'/>
      <model type='virtio'/>
      <rom bar='off'/>
      <port isolated='yes'/>
    </interface>

    <!-- Installer: PS/2 garantiert Eingabe ohne USB-Passthrough/-Controller. -->
    <input type='keyboard' bus='ps2'/>
    <input type='mouse' bus='ps2'/>

    <graphics type='spice' autoport='yes'>
      <listen type='none'/>
      <clipboard copypaste='no'/>
      <filetransfer enable='no'/>
      <gl enable='no'/>
    </graphics>

    <video>
      <model type='virtio' heads='1' primary='yes'/>
    </video>

    <memballoon model='none'/>
  </devices>
</domain>
