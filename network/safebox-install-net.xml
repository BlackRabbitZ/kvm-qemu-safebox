<network>
  <name>safebox-install-net</name>
  <forward mode='nat'/>
  <bridge name='virbr-safebox-inst' stp='off' delay='0' macTableManager='libvirt'/>
  <port isolated='yes'/>

  <!-- Nur für die vertrauenswürdige Debian-Erstinstallation. -->
  <domain name='safebox-install.invalid' localOnly='yes'/>
  <dns enable='yes' forwardPlainNames='no'/>
  <ip address='10.77.0.1' netmask='255.255.255.0'>
    <dhcp>
      <host mac='52:54:00:77:00:10' name='safebox-installer' ip='10.77.0.100'/>
    </dhcp>
  </ip>
</network>
