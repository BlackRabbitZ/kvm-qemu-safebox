#!/usr/sbin/nft -f

# Hostseitige, fail-closed Netzwerkgrenze für SafeBox.
# Der Runtime-Gast gilt als vollständig kompromittierbar. Deshalb besitzt die
# Runtime-Bridge absichtlich KEINEN erlaubten Gast->Host-Dienst.

table inet safebox_guard {
    set blocked_v4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    chain input {
        type filter hook input priority -50; policy accept;

        # Runtime: weder IPv4- noch IPv6-Dienste des Hosts sind erreichbar.
        iifname "virbr-safebox" meta nfproto ipv6 drop
        iifname "virbr-safebox" drop

        # Installer-Netz: IPv6 ebenfalls vollständig aus. Nur DHCP/DNS sind
        # während der vertrauenswürdigen OS-Erstinstallation erreichbar.
        iifname "virbr-safebox-inst" meta nfproto ipv6 drop
        iifname "virbr-safebox-inst" ip saddr { 0.0.0.0, 10.77.0.100 } udp sport 68 dport 67 accept
        iifname "virbr-safebox-inst" ip saddr 10.77.0.100 ip daddr 10.77.0.1 udp dport 53 accept
        iifname "virbr-safebox-inst" ip saddr 10.77.0.100 ip daddr 10.77.0.1 tcp dport 53 accept
        iifname "virbr-safebox-inst" drop
    }

    chain output {
        type filter hook output priority -50; policy accept;

        # IPv6 in Richtung beider SafeBox-Bridges vollständig sperren.
        oifname "virbr-safebox" meta nfproto ipv6 drop
        oifname "virbr-safebox-inst" meta nfproto ipv6 drop

        # Runtime: ausschließlich Antworten auf bereits vom Gast initiierte
        # Host-Verbindungen; da input alles droppt, existiert normal keine.
        oifname "virbr-safebox" ct state established,related accept
        oifname "virbr-safebox" drop

        # Installer: DHCP-Antworten und Antworten auf DHCP/DNS zulassen.
        oifname "virbr-safebox-inst" udp sport 67 dport 68 accept
        oifname "virbr-safebox-inst" ct state established,related accept
        oifname "virbr-safebox-inst" drop
    }

    chain forward {
        type filter hook forward priority -50; policy accept;

        # IPv6 in BEIDEN Richtungen vollständig blockieren.
        iifname "virbr-safebox" meta nfproto ipv6 drop
        oifname "virbr-safebox" meta nfproto ipv6 drop
        iifname "virbr-safebox-inst" meta nfproto ipv6 drop
        oifname "virbr-safebox-inst" meta nfproto ipv6 drop

        # Beide Modi dürfen ausschließlich die fest vorgesehene IPv4 nutzen.
        iifname "virbr-safebox" ip saddr != 10.77.0.100 drop
        iifname "virbr-safebox-inst" ip saddr != 10.77.0.100 drop

        # Kein Routing zu LAN-, Loopback-, Link-Local-, CGNAT- oder anderen
        # nicht-öffentlichen/speziellen IPv4-Zielen.
        iifname "virbr-safebox" ip daddr @blocked_v4 drop
        iifname "virbr-safebox-inst" ip daddr @blocked_v4 drop

        # Zum Gast ausschließlich Antworten auf bereits etablierte Sessions.
        oifname "virbr-safebox" ct state established,related accept
        oifname "virbr-safebox" drop
        oifname "virbr-safebox-inst" ct state established,related accept
        oifname "virbr-safebox-inst" drop
    }
}
