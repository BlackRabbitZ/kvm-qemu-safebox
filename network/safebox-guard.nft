#!/usr/sbin/nft -f

# Defense-in-depth für die dedizierte SafeBox-Bridge.
# Libvirt stellt NAT/DHCP/DNS bereit. Diese Tabelle verhindert zusätzlich:
#   * Zugriff der VM auf den Host (außer DHCP und DNS)
#   * Zugriff der VM auf RFC1918/LAN-, Link-Local- und weitere Spezialnetze
# Internet-Ziele bleiben erlaubt.

table inet safebox_guard {
    set blocked_v4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    set blocked_v6 {
        type ipv6_addr
        flags interval
        elements = {
            ::/128,
            ::1/128,
            fc00::/7,
            fe80::/10,
            ff00::/8,
            2001:db8::/32
        }
    }

    chain input {
        type filter hook input priority -50; policy accept;

        # DHCP und DNS des libvirt-dnsmasq auf dem Host sind die einzigen
        # absichtlich erreichbaren Host-Dienste für die SafeBox.
        iifname "virbr-safebox" udp sport 68 dport 67 accept
        iifname "virbr-safebox" ip saddr 10.77.0.100 udp dport 53 accept
        iifname "virbr-safebox" ip saddr 10.77.0.100 tcp dport 53 accept

        # Alles andere VM -> Host blockieren.
        iifname "virbr-safebox" drop
    }

    chain forward {
        type filter hook forward priority -50; policy accept;

        # Keine frei gewählte Quell-IP aus dem Gast routen. Die VM erhält
        # absichtlich genau 10.77.0.100 per statischer DHCP-Zuordnung.
        iifname "virbr-safebox" ip saddr != 10.77.0.100 drop

        # SafeBox darf nicht in private/LAN/Spezialnetze routen.
        iifname "virbr-safebox" ip daddr @blocked_v4 drop
        iifname "virbr-safebox" ip6 daddr @blocked_v6 drop
    }
}
